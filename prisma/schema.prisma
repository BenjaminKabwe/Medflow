generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

generator prismaClient {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  doctors     Doctor[]
  staff       Staff[]
}

model Patient {
  id                       String           @id
  first_name               String
  last_name                String
  date_of_birth            DateTime
  gender                   Gender           @default(MALE)
  phone                    String
  email                    String           @unique
  marital_status           MaritalStatus
  address                  String
  emergency_contact_name   String
  emergency_contact_number String
  relation                 String
  blood_group              String?
  allergies                String?
  medical_conditions       String?
  medical_history          String?
  insurance_provider       String?
  insurance_number         String?
  privacy_consent          Boolean
  service_consent          Boolean
  medical_consent          Boolean
  img                      String?
  colorCode                String?
  created_at               DateTime         @default(now())
  updated_at               DateTime         @updatedAt
  appointments             Appointment[]
  diagnosis                Diagnosis[]
  medical                  MedicalRecords[]
  payments                 Payment[]
  ratings                  Rating[]
  vital_signs              VitalSigns[]
  dispensations            Dispensation[]
  prescriptions            Prescription[]

  @@index([last_name, first_name])
  @@index([phone])
}

model Doctor {
  id                  String              @id
  email               String              @unique
  name                String
  specialization      String
  license_number      String              @unique
  phone               String
  address             String
  department_id       Int?
  img                 String?
  colorCode           String?
  availability_status AvailabilityStatus? @default(AVAILABLE)
  type                JOBTYPE             @default(FULL)
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  appointments        Appointment[]
  diagnosis           Diagnosis[]
  department          Department?         @relation(fields: [department_id], references: [id])
  doctor_leaves       DoctorLeave[]
  medical_records     MedicalRecords[]
  prescriptions       Prescription[]
  ratings             Rating[]
  working_days        WorkingDays[]

  @@index([department_id])
  @@index([specialization])
}

model DoctorLeave {
  id         Int      @id @default(autoincrement())
  doctor_id  String
  start_date DateTime
  end_date   DateTime
  reason     String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  doctor     Doctor   @relation(fields: [doctor_id], references: [id], onDelete: Cascade)

  @@index([doctor_id])
  @@index([start_date, end_date])
}

model WorkingDays {
  id         Int      @id @default(autoincrement())
  doctor_id  String
  day        WeekDay
  start_time String
  close_time String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  doctor     Doctor   @relation(fields: [doctor_id], references: [id], onDelete: Cascade)

  @@unique([doctor_id, day])
  @@index([doctor_id])
}

model Staff {
  id             String      @id
  email          String      @unique
  name           String
  phone          String
  address        String
  department_id  Int?
  img            String?
  license_number String?
  colorCode      String?
  role           Role
  status         Status      @default(ACTIVE)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  department     Department? @relation(fields: [department_id], references: [id])

  @@index([department_id])
  @@index([role])
  @@index([status])
}

model Appointment {
  id               Int               @id @default(autoincrement())
  patient_id       String
  doctor_id        String
  appointment_date DateTime
  time             String
  status           AppointmentStatus @default(PENDING)
  type             String
  note             String?
  reason           String?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  doctor           Doctor            @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  patient          Patient           @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  medical          MedicalRecords[]
  bills            Payment?
  notifications    Notification[]

  @@unique([doctor_id, appointment_date, time])
  @@unique([patient_id, appointment_date, time])
  @@index([patient_id])
  @@index([doctor_id])
  @@index([appointment_date])
}

// ─────────────────────────────────────────
// PAYMENT — 3 champs caissier ajoutés
// ─────────────────────────────────────────

model Payment {
  id             Int             @id @default(autoincrement())
  bill_id        Int?
  patient_id     String
  appointment_id Int             @unique
  bill_date      DateTime
  payment_date   DateTime
  discount       Float           @default(0)
  total_amount   Float
  amount_paid    Float
  payment_method PaymentMethod   @default(CASH)
  status         PaymentStatus   @default(UNPAID)
  receipt_number String          @unique
  cashier_id     String?
  cashier_name   String?
  session_id     Int?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  bills          PatientBills[]
  appointment    Appointment     @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  patient        Patient         @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  session        CashierSession? @relation(fields: [session_id], references: [id], onDelete: SetNull)

  @@index([patient_id])
  @@index([bill_date])
  @@index([payment_date])
  @@index([status])
  @@index([session_id])
  @@index([cashier_id])
}

model PatientBills {
  id           Int      @id @default(autoincrement())
  bill_id      Int
  service_id   Int
  service_date DateTime
  quantity     Int
  unit_cost    Float
  total_cost   Float
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  payment      Payment  @relation(fields: [bill_id], references: [id], onDelete: Cascade)
  service      Services @relation(fields: [service_id], references: [id])

  @@index([bill_id])
  @@index([service_id])
}

model LabTest {
  id                Int            @id @default(autoincrement())
  record_id         Int
  service_id        Int
  status            LabTestStatus  @default(REQUESTED)
  result            String?
  notes             String?
  requested_by      String?
  requested_by_name String?
  performed_by      String?
  performed_by_name String?
  test_date         DateTime?
  completed_at      DateTime?
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  medical_record    MedicalRecords @relation(fields: [record_id], references: [id], onDelete: Cascade)
  services          Services       @relation(fields: [service_id], references: [id])

  @@index([record_id])
  @@index([service_id])
  @@index([status])
}

model MedicalRecords {
  id             Int             @id @default(autoincrement())
  patient_id     String
  appointment_id Int
  doctor_id      String
  treatment_plan String?
  prescriptions  String?
  lab_request    String?
  notes          String?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  diagnosis      Diagnosis[]
  lab_test       LabTest[]
  appointment    Appointment     @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  doctor         Doctor          @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  patient        Patient         @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  vital_signs    VitalSigns[]
  dispensations  Dispensation[]
  structured_prescriptions Prescription[]

  @@index([patient_id])
  @@index([appointment_id])
  @@index([doctor_id])
}

model VitalSigns {
  id                Int            @id @default(autoincrement())
  patient_id        String
  medical_id        Int
  body_temperature  Float
  systolic          Int
  diastolic         Int
  heartRate         String
  respiratory_rate  Int?
  oxygen_saturation Int?
  weight            Float
  height            Float
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  medical           MedicalRecords @relation(fields: [medical_id], references: [id], onDelete: Cascade)
  patient           Patient        @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@index([patient_id])
  @@index([medical_id])
}

model Diagnosis {
  id                     Int            @id @default(autoincrement())
  patient_id             String
  medical_id             Int
  doctor_id              String
  symptoms               String
  diagnosis              String
  notes                  String?
  prescribed_medications String?
  follow_up_plan         String?
  created_at             DateTime       @default(now())
  updated_at             DateTime       @updatedAt
  doctor                 Doctor         @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  medical                MedicalRecords @relation(fields: [medical_id], references: [id], onDelete: Cascade)
  patient                Patient        @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@index([patient_id])
  @@index([doctor_id])
  @@index([medical_id])
}

model AuditLog {
  id         Int         @id @default(autoincrement())
  user_id    String
  record_id  String
  action     AuditAction
  details    String?
  model      String
  old_values String?
  new_values String?
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  @@index([user_id])
  @@index([model, record_id])
  @@index([action])
}

model Rating {
  id         Int      @id @default(autoincrement())
  staff_id   String
  patient_id String
  rating     Int
  comment    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  patient    Patient  @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  doctor     Doctor   @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@index([staff_id])
  @@index([patient_id])
}

model Services {
  id           Int            @id @default(autoincrement())
  service_name String         @unique
  description  String
  price        Float
  category     String?
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  labtest      LabTest[]
  bills        PatientBills[]
}

model Notification {
  id             Int              @id @default(autoincrement())
  user_id        String
  sender_id      String?
  title          String
  message        String
  type           NotificationType @default(INFO)
  read           Boolean          @default(false)
  read_at        DateTime?
  appointment_id Int?
  appointment    Appointment?     @relation(fields: [appointment_id], references: [id])
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  @@index([user_id])
  @@index([read])
  @@index([appointment_id])
}

// ─────────────────────────────────────────
// NOUVEAUX MODÈLES
// ─────────────────────────────────────────

model PaymentMethodConfig {
  id          Int           @id @default(autoincrement())
  method      PaymentMethod @unique
  label       String
  description String?
  icon        String?
  isActive    Boolean       @default(true)
  fees        Float         @default(0)
  metadata    Json?
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
}

model CashierSession {
  id              Int           @id @default(autoincrement())
  cashier_id      String
  cashier_name    String
  opened_at       DateTime      @default(now())
  closed_at       DateTime?
  opening_amount  Float         @default(0)
  closing_amount  Float?
  total_cash      Float?
  total_card      Float?
  total_mobile    Float?
  total_insurance Float?
  total_transfer  Float?
  notes           String?
  status          SessionStatus @default(OPEN)
  payments        Payment[]

  @@index([cashier_id])
  @@index([status])
  @@index([opened_at])
}

// ─────────────────────────────────────────
// MODULE PHARMACIE (V2)
// ─────────────────────────────────────────

model Medication {
  id                    Int                  @id @default(autoincrement())
  name                  String
  dci                   String
  form                  MedicationForm       @default(COMPRIME)
  dosage                String
  unit                  String               @default("boîte")
  category              String?
  description           String?
  barcode               String?              @unique
  prescription_required Boolean              @default(true)
  reorder_level         Int                  @default(10)
  is_active             Boolean              @default(true)
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  stocks                MedicationStock[]
  purchase_items        PurchaseOrderItem[]
  dispensation_items    DispensationItem[]
  prescription_items    PrescriptionItem[]

  @@unique([dci, dosage, form])
  @@index([name])
  @@index([dci])
  @@index([category])
  @@index([is_active])
}

model MedicationStock {
  id             Int              @id @default(autoincrement())
  medication_id  Int
  batch_number   String
  quantity       Int              @default(0)
  unit_cost      Float
  selling_price  Float
  expiry_date    DateTime
  received_date  DateTime         @default(now())
  supplier_id    Int?
  notes          String?
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  medication     Medication       @relation(fields: [medication_id], references: [id], onDelete: Cascade)
  supplier       Supplier?        @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  movements      StockMovement[]
  dispensation_items DispensationItem[]

  @@unique([medication_id, batch_number])
  @@index([medication_id])
  @@index([expiry_date])
  @@index([supplier_id])
}

model StockMovement {
  id           Int               @id @default(autoincrement())
  stock_id     Int
  type         StockMovementType
  quantity     Int
  reason       String?
  reference    String?
  user_id      String
  user_name    String
  created_at   DateTime          @default(now())
  stock        MedicationStock   @relation(fields: [stock_id], references: [id], onDelete: Cascade)

  @@index([stock_id])
  @@index([type])
  @@index([created_at])
}

model Supplier {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  contact_person String?
  email          String?
  phone          String
  address        String?
  tax_id         String?
  is_active      Boolean          @default(true)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  stocks         MedicationStock[]
  orders         PurchaseOrder[]

  @@index([is_active])
}

model PurchaseOrder {
  id            Int                 @id @default(autoincrement())
  reference     String              @unique
  supplier_id   Int
  order_date    DateTime            @default(now())
  expected_date DateTime?
  received_date DateTime?
  status        PurchaseOrderStatus @default(DRAFT)
  total_amount  Float               @default(0)
  notes         String?
  created_by    String
  created_at    DateTime            @default(now())
  updated_at    DateTime            @updatedAt
  supplier      Supplier            @relation(fields: [supplier_id], references: [id])
  items         PurchaseOrderItem[]

  @@index([supplier_id])
  @@index([status])
  @@index([order_date])
}

model PurchaseOrderItem {
  id                Int           @id @default(autoincrement())
  order_id          Int
  medication_id     Int
  quantity_ordered  Int
  quantity_received Int           @default(0)
  unit_cost         Float
  total_cost        Float
  order             PurchaseOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  medication        Medication    @relation(fields: [medication_id], references: [id])

  @@index([order_id])
  @@index([medication_id])
}

model Dispensation {
  id                Int                @id @default(autoincrement())
  reference         String             @unique
  patient_id        String
  medical_record_id Int?
  prescription_id   Int?
  dispensed_by      String
  dispensed_by_name String
  dispensed_at      DateTime           @default(now())
  notes             String?
  total_amount      Float              @default(0)
  status            DispensationStatus @default(DISPENSED)
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  patient           Patient            @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  medical_record    MedicalRecords?    @relation(fields: [medical_record_id], references: [id], onDelete: SetNull)
  prescription      Prescription?      @relation(fields: [prescription_id], references: [id], onDelete: SetNull)
  items             DispensationItem[]

  @@index([patient_id])
  @@index([medical_record_id])
  @@index([prescription_id])
  @@index([dispensed_at])
  @@index([status])
}

model DispensationItem {
  id              Int             @id @default(autoincrement())
  dispensation_id Int
  stock_id        Int
  medication_id   Int
  quantity        Int
  unit_price      Float
  total_price     Float
  instructions    String?
  dispensation    Dispensation    @relation(fields: [dispensation_id], references: [id], onDelete: Cascade)
  stock           MedicationStock @relation(fields: [stock_id], references: [id])
  medication      Medication      @relation(fields: [medication_id], references: [id])

  @@index([dispensation_id])
  @@index([stock_id])
  @@index([medication_id])
}

model Prescription {
  id                Int                @id @default(autoincrement())
  reference         String             @unique
  patient_id        String
  medical_record_id Int?
  appointment_id    Int?
  doctor_id         String
  doctor_name       String
  status            PrescriptionStatus @default(PENDING)
  notes             String?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  patient           Patient            @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  medical_record    MedicalRecords?    @relation(fields: [medical_record_id], references: [id], onDelete: SetNull)
  doctor            Doctor             @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  items             PrescriptionItem[]
  dispensations     Dispensation[]

  @@index([patient_id])
  @@index([doctor_id])
  @@index([medical_record_id])
  @@index([status])
  @@index([created_at])
}

model PrescriptionItem {
  id                  Int          @id @default(autoincrement())
  prescription_id     Int
  medication_id       Int
  quantity_prescribed Int
  quantity_dispensed  Int          @default(0)
  dosage              String
  duration            String?
  instructions        String?
  prescription        Prescription @relation(fields: [prescription_id], references: [id], onDelete: Cascade)
  medication          Medication   @relation(fields: [medication_id], references: [id])

  @@index([prescription_id])
  @@index([medication_id])
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  ADMIN
  NURSE
  DOCTOR
  LAB_TECHNICIAN
  PATIENT
  CASHIER
  PHARMACIST
}

enum Status {
  ACTIVE
  INACTIVE
  DORMANT
}

enum JOBTYPE {
  FULL
  PART
}

enum Gender {
  MALE
  FEMALE
}

enum AppointmentStatus {
  PENDING
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  INSURANCE
  BANK_TRANSFER
}

enum PaymentStatus {
  PAID
  UNPAID
  PART
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum LabTestStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  ON_LEAVE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  LOGIN
  LOGOUT
}

enum NotificationType {
  INFO
  NOUVEAU_RENDEZ_VOUS
  RENDEZ_VOUS_CONFIRME
  RENDEZ_VOUS_ANNULE
  RENDEZ_VOUS_MODIFIE
  PAIEMENT_RECU
  STOCK_BAS
  MEDICAMENT_EXPIRE
  DISPENSATION
}

enum MedicationForm {
  COMPRIME
  GELULE
  SIROP
  SUSPENSION
  INJECTION
  POMMADE
  CREME
  GOUTTE
  SUPPOSITOIRE
  PATCH
  INHALATEUR
  SACHET
  AUTRE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
  EXPIRED
  LOSS
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum DispensationStatus {
  DISPENSED
  CANCELLED
  RETURNED
}

enum PrescriptionStatus {
  PENDING
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}
